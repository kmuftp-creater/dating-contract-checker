# 部署版本。決定掛上哪些擴充（見 src/lib/email/hooks.ts），這份程式沒有掛任何擴充
EDITION=public

# 前台網域
PUBLIC_HOST=example.gov.tw

# 後台網域。留空＝與前台共用同一個網址，後台在 /admincenter，靠登入保護。
# 想讓後台走獨立網域時才填，填了之後前台網域連 /admincenter 都會回 404，
# 等於在登入之外多一道與身分驗證無關的防線，代價是多一筆 DNS 與一張憑證。
ADMIN_HOST=

# 前面有哪一種代理，決定從哪個標頭取使用者的真實 IP
# cloudflare：有 Cloudflare 代理在前，只認 CF-Connecting-IP
# nginx：只有自架反向代理，取轉發標頭最右邊那一段
# none：沒有任何代理（開發環境），完全忽略標頭
# 設錯會讓防濫用失效，正式部署務必依實際架構設定
TRUSTED_PROXY=nginx

# 資料庫
DATABASE_URL=postgres://contract:請改成你的密碼@postgres:5432/contract_check
POSTGRES_PASSWORD=請改成你的密碼

# 加密資料庫內的 AI 金鑰與 SMTP 密碼。用 openssl rand -base64 32 產生
APP_ENCRYPTION_KEY=

# 後台登入。用 openssl rand -base64 32 產生 AUTH_SECRET
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# 後台白名單信箱，逗號分隔。不填的話沒有人能登入後台
ADMIN_EMAILS=

# 營運本服務的單位名稱，例如「○○市政府民政局」或你的公司名。
# 這個名字會代入隱私權政策與服務條款裡的 {{營運者名稱}}。
# 不填的話那兩份文件會顯示「本服務的營運單位」，請務必填寫。
OPERATOR_NAME=

# 頁尾要不要顯示「本站由誰營運」的連結。兩個都填才會顯示，留空就不顯示。
# 這是**你自己的**標示；工具的開發者標示是另一回事，寫在程式碼裡，
# 依 MIT 授權請保留。
NEXT_PUBLIC_SITE_CREDIT_LABEL=
NEXT_PUBLIC_SITE_CREDIT_URL=

# 上傳檔案存放目錄
UPLOAD_DIR=/data/uploads

TZ=Asia/Taipei
